      "name": "01 Register test requester",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/signup",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"firstName\": \"QA\",\n  \"password1\": \"{{password}}\",\n  \"password2\": \"{{password}}\",\n  \"phone\": \"+77005550101\",\n  \"city\": \"Almaty\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"No server error\", () => pm.expect(pm.response.code).to.be.below(500));"
            ]
          }
        }
      ]
    },
