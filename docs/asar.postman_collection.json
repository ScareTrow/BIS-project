{
  "info": {
    "name": "ASAR reconstructed QA collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Prepared from current Flask routes; not the original collection claimed in TSIS 3. Create helper and admin accounts in a disposable database before running."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "email",
      "value": "qa@example.com"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "helperEmail",
      "value": ""
    },
    {
      "key": "helperPassword",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""
    },
    {
      "key": "responseId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Register test requester",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/signup",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"firstName\": \"QA\",\n  \"password1\": \"{{password}}\",\n  \"password2\": \"{{password}}\",\n  \"phone\": \"+77005550101\",\n  \"city\": \"Almaty\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"No server error\", () => pm.expect(pm.response.code).to.be.below(500));"
            ]
          }
        }
      ]
    },
    {
