    {
      "name": "October mutual aid — manual role-specific requests",
      "description": "Log in as the owner/helper/admin required by each operation. Set aidApplicationId, aidResponseId, aidNeedId, aidResourceId and aidConfirmationId to records you created. Requests are examples, not a fully automated collection runner. Use docs/mutual-aid-implementation.md for prerequisites.",
      "item": [
        {
          "name": "Capabilities",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/capabilities"
          }
        },
        {
          "name": "My capabilities",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/user/capabilities"
          }
        },
        {
          "name": "Set available",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/user/capabilities",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"capability_ids\": [],\n  \"is_available\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Matching",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/applications/matching"
          }
        },
        {
          "name": "Need totals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/applications/{{aidApplicationId}}/aid"
          }
        },
        {
          "name": "Accepted contribution",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/responses/{{aidResponseId}}/contributions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"need_id\": {{aidNeedId}},\n  \"quantity_promised\": 3,\n  \"quantity_delivered\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Confirm response completion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/responses/{{aidResponseId}}/complete"
          }
        },
        {
          "name": "Rate completed help",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/responses/{{aidResponseId}}/rating",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"score\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Resource offers",
