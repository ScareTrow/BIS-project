    "/api/applications": {
      "post": {
        "operationId": "api_create_application",
        "summary": "api create application",
        "description": "Route inventory from Flask source. General response schema unless specified below.",
        "responses": {
          "200": {
            "description": "Successful response; see route implementation for envelope"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permission"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "latitude",
                  "longitude",
                  "category",
                  "description"
                ],
                "properties": {
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "food",
                      "medicine",
                      "shelter",
                      "emergency"
                    ]
                  },
                  "description": {
                    "type": "string"
                  },
                  "expires_days": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 365,
                    "default": 7
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "latitude",
                  "longitude",
                  "category",
                  "description",
                  "media_files"
                ],
                "properties": {
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
